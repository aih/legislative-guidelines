{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aih.github.io/legislative-guidelines/guidelines.schema.json",
  "title": "Legislative Drafting Guidelines Catalog Schema",
  "description": "Schema for national, supranational, and international legislative drafting guidelines catalog entries, aligned with Akoma Ntoso (OASIS LegalDocML) and Schema.org Legislation metadata.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "jurisdiction",
      "jurisdiction_level",
      "country_code",
      "region",
      "issuing_body",
      "languages",
      "document_type",
      "currency",
      "original_format"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$",
        "description": "Stable lower-case slug (<country-or-org-code>-<short-title>)."
      },
      "title": {
        "type": "string",
        "minLength": 2,
        "description": "Title in the original language."
      },
      "title_en": {
        "type": ["string", "null"],
        "description": "English translation of a non-English title."
      },
      "jurisdiction": {
        "type": "string",
        "minLength": 2,
        "description": "Country, state/devolved nation, or international organisation."
      },
      "jurisdiction_level": {
        "type": "string",
        "enum": ["national", "supranational", "international", "subnational"],
        "description": "Level of governance."
      },
      "country_code": {
        "type": "string",
        "pattern": "^[A-Z]{2,10}(-[A-Z]{2,4})?$",
        "description": "ISO 3166-1 alpha-2, ISO 3166-2 subdivision code (e.g. GB-SCT), or organisation code (EU, UN, OECD, OSCE, COE, COMSEC, ASEAN, AU, OAS, CARICOM, ECOWAS, MERCOSUR)."
      },
      "region": {
        "type": "string",
        "enum": ["Europe", "Americas", "Asia", "Africa", "Oceania", "International"]
      },
      "issuing_body": {
        "type": "string",
        "minLength": 2
      },
      "languages": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^([a-z]{2,3}|multilingual)$"
        }
      },
      "document_type": {
        "type": "string",
        "minLength": 2
      },
      "legal_status": {
        "type": ["string", "null"]
      },
      "legal_tradition": {
        "type": "string",
        "enum": ["common_law", "civil_law", "bijural", "hybrid", "supranational", "international"],
        "description": "Underlying legal system or drafting tradition."
      },
      "normative_status": {
        "type": "string",
        "enum": ["mandatory", "advisory", "interinstitutional", "statute"],
        "description": "Whether the drafting rules are legally binding, interinstitutional, or advisory guidance."
      },
      "edition": {
        "type": ["string", "null"]
      },
      "published": {
        "type": ["string", "null"]
      },
      "last_updated": {
        "type": ["string", "null"]
      },
      "currency": {
        "type": "object",
        "required": ["status", "checked_on"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["current", "in-force", "dated", "superseded", "unverified"]
          },
          "note": {
            "type": ["string", "null"]
          },
          "superseded": {
            "type": ["string", "null"]
          },
          "superseded_by": {
            "type": ["string", "null"]
          },
          "checked_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "additionalProperties": false
      },
      "original_format": {
        "type": "string",
        "minLength": 2
      },
      "source_url": {
        "type": ["string", "null"],
        "pattern": "^https?://.+"
      },
      "landing_url": {
        "type": ["string", "null"],
        "pattern": "^https?://.+"
      },
      "html_edition_url": {
        "type": ["string", "null"],
        "pattern": "^https?://.+"
      },
      "crawl": {
        "type": "object",
        "required": ["prefix"],
        "properties": {
          "prefix": {
            "type": "string",
            "pattern": "^https?://.+"
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "license": {
        "type": ["string", "null"]
      },
      "notes": {
        "type": ["string", "null"]
      },
      "topics": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Thematic tags covered by the guideline (e.g., plain_language, gender_neutrality, recitals, definitions, amending_formulas, multilingual_drafting, digital_ready)."
      },
      "key_principles": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Core actionable legislative drafting rules extracted from this guideline."
      }
    },
    "additionalProperties": false
  }
}
